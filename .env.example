# ===================================================================
# ÖRNEK ÇEVRE DEĞİŞKENLERİ (.env.example)
# ===================================================================
# Bu dosya bir şablondur. Canlı / yerel ortam için bu dosyayı kopyalayıp
# '.env' adıyla kaydedebilir ve kendi değerlerinizi belirleyebilirsiniz:
#   Windows (PowerShell): cp .env.example .env
#   Linux / Mac:          cp .env.example .env
#
# DİKKAT: '.env' dosyası hassas veriler barındırabileceğinden .gitignore
# tarafından takip edilmez, ancak bu '.env.example' dosyası depoya eklenir.
# ===================================================================

# Sunucu ve Ağ Ayarları
PORT=port_numaranizi_giriniz_ornek_3000
HOST=host_adresinizi_giriniz_ornek_0.0.0.0
ENVIRONMENT=calisma_ortaminizi_giriniz_development_veya_production
LOG_LEVEL=log_seviyenizi_giriniz_info_debug

# Proje ve Akademik Bilgiler
APP_NAME=uygulama_adinizi_giriniz
STUDENT_NAME=ad_soyad_bilginizi_giriniz
COURSE_CODE=ders_kodunuzu_giriniz
UNIVERSITY=universite_adinizi_giriniz

# Mimari ve Veri Modeli Bilgileri
ARCHITECTURE=mimari_yapinizi_giriniz_ornek_MVC
STORAGE_TYPE=veri_depolama_tipinizi_giriniz_ornek_In-Memory
DATA_DESIGN_DOC=veri_tasarim_dokumani_dosya_adinizi_giriniz_ornek_ddd.md
